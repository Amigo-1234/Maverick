# ─────────────────────────────────────────────────────────────────────────────
# MAVERICK website settings
# Copy this file to .env.local (on your computer) and fill in the values.
# On the live host (e.g. Vercel), add the same names under Settings → Environment Variables.
# NEVER commit .env.local or paste secret keys into chats, emails or GitHub.
# Store details (WhatsApp number, socials, delivery fees, announcement…) are NOT here:
# they're edited in the admin dashboard → Settings / Delivery.
# ─────────────────────────────────────────────────────────────────────────────

# The site's public address, with no trailing slash. Used for share previews, the sitemap, emails and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (orders, products, stock, customers, inquiries…) ────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Leave empty on your computer to use the built-in local test database (stored in .data/).
# REQUIRED in production. Then run:  DATABASE_URL=… npm run db:migrate
DATABASE_URL=
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# ── Security ─────────────────────────────────────────────────────────────────
# Long random text that signs order-tracking links. REQUIRED in production.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ── First admin account ──────────────────────────────────────────────────────
# On the very first sign-in at /admin/login, this email + password creates the OWNER account.
# After that, manage the team and passwords in Admin → Settings (these values are no longer used).
ADMIN_EMAIL=
# At least 10 characters.
ADMIN_PASSWORD=

# ── Paystack (payments) ──────────────────────────────────────────────────────
# Paystack dashboard → Settings → API Keys & Webhooks.
# Use the TEST secret key (sk_test_…) until you've tried a full order, then switch to LIVE (sk_live_…).
PAYSTACK_SECRET_KEY=
# Also in that screen: set the Webhook URL to  https://YOUR-DOMAIN/api/paystack/webhook
# Minutes a checkout holds stock while the customer pays (default 30).
# STOCK_RESERVATION_MINUTES=30

# ── Email (order alerts, receipts, status updates, inquiries) via Resend ────
# resend.com → API Keys. Verify your domain in Resend first so emails don't land in spam.
RESEND_API_KEY=
# Sender shown on emails, on your verified domain, e.g.  MAVERICK <orders@yourdomain.com>
EMAIL_FROM=
# Fallback inbox for order alerts and inquiries (Admin → Settings can override it).
ORDER_NOTIFY_EMAIL=
# Optional: a Resend Audience ID to collect newsletter sign-ups. If empty, sign-ups are emailed to you instead.
RESEND_AUDIENCE_ID=

# ── Optional: ad pixels (leave empty to keep them off) ──────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
